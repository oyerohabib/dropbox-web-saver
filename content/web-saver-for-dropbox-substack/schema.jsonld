  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "headline": "Stop Downloading Just to Upload: Save Web Files Straight to Dropbox",
      "datePublished": "2026-10-19",
      "author": { "@type": "Person", "name": "Oyero Habib", "url": "https://github.com/oyerohabib", "email": "oyerohabib@yahoo.com" },
      "image": "./hero.png",
      "description": "Skip Download → Finder → Upload. Save images to Dropbox, or save web files to Dropbox without downloading. Free MIT Chromium extension; keys stay in-browser."
    },
    {
      "@type": "SoftwareApplication",
      "name": "Web Saver for Dropbox",
      "applicationCategory": "BrowserApplication",
      "operatingSystem": "Chrome, Brave, Edge",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "url": "https://chromewebstore.google.com/detail/web-saver-for-dropbox/hpgokiookclncalkhobnlpcgfnafjhbi",
