    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need a paid Dropbox plan?",
          "acceptedAnswer": { "@type": "Answer", "text": "You need a Dropbox account the API can write to. Plan limits are Dropbox’s, not Web Saver’s. The extension is free OSS either way." }
        },
        {
          "@type": "Question",
          "name": "Why can’t the extension just sign in with Dropbox without an app key?",
          "acceptedAnswer": { "@type": "Answer", "text": "It can only talk to Dropbox as an app. Using your app means tokens are scoped to credentials you control, not a shared multi-tenant app operated by a middleman." }
        },
        {
          "@type": "Question",
          "name": "Will it save any video I see on a page?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Ordinary downloadable file links and many images work. Streamed players and blob URLs often will not." }
        },
        {
          "@type": "Question",
          "name": "Is this an official Dropbox product?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Web Saver for Dropbox is an independent MIT project by Oyero Habib. It is not affiliated with, endorsed by, or sponsored by Dropbox, Inc." }
        }
      ]
    }
  ]
}
