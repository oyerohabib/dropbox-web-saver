# Public Dropbox app key (OAuth client id). This is not a secret.
# Leave it empty to connect with your own Dropbox app from the extension settings.
# Never put the Dropbox app secret or any token in this file.
WXT_DROPBOX_APP_KEY=

# Google OAuth client for Drive (Web application type). Chrome Extension clients
# do not work with launchWebAuthFlow (redirect_uri_mismatch).
# Create Credentials → OAuth client → Web application, add Authorized redirect URI:
#   https://<extension-id-from-chrome://extensions>.chromiumapp.org/
# Unpacked builds use a different id than the Chrome Web Store listing.
# The client secret is required for Google's token endpoint. It ships in the
# built extension (installed-app secret); never commit .env.
WXT_GOOGLE_CLIENT_ID=
WXT_GOOGLE_CLIENT_SECRET=
